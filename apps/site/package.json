{
  "name": "@slop/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "mkdir -p public && cp node_modules/@slop/model/weights/model.bin public/model.bin && cp node_modules/@slop/model/weights/lm/model.bin public/model-lm.bin",
    "dev": "next dev",
    "prebuild": "mkdir -p public && cp node_modules/@slop/model/weights/model.bin public/model.bin && cp node_modules/@slop/model/weights/lm/model.bin public/model-lm.bin && WXT_API_BASE=${WXT_API_BASE:-https://slop-meter.com} pnpm --filter @slop/extension zip && cp ../extension/.output/slop-meter-chrome.zip public/slop-meter-chrome.zip",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@firecrawl/anydoc-wasm": "^0.2.4",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sfinterface/numbers": "^0.3.4",
    "@slop/eval": "workspace:*",
    "@slop/features": "workspace:*",
    "@slop/lm": "workspace:*",
    "@slop/model": "workspace:*",
    "@slop/rules": "workspace:*",
    "@slop/theme": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.100",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "cube-motion": "^0.1.0",
    "motion": "^12.43.0",
    "next": "^16.3.5",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.66",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9"
  }
